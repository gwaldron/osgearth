                ImGuiLTable::Text("Where", "%s", s.water ? "In the water" : "On the bank");
                ImGuiLTable::Text("Water level", "%.2f m", s.level);
                ImGuiLTable::Text("Depth", "%.2f m", s.depth);
                ImGuiLTable::Text(s.water ? "To the bank" : "To the water", "%.1f m", std::abs(s.shore));
                ImGuiLTable::Text("Across", "%.0f%% (0 = centerline)", s.across * 100.0f);
                double bearing = osg::RadiansToDegrees(std::atan2((double)s.flow.x(), (double)s.flow.y()));
                double heading = std::fmod(bearing + 360.0, 360.0);
                if (s.speed > 0.01f)
                    ImGuiLTable::Text("Current", "%.2f m/s toward %.0f deg", s.speed, heading);
                else
                    ImGuiLTable::Text("Current", "%s", "still");
                ImGuiLTable::Text("Surface slope", "%.2f%%", s.slope * 100.0f);
                ImGuiLTable::Text("Whitewater", "%.0f%%", s.turbulence * 100.0f);
                if (s.fall > 0.5f)
                    ImGuiLTable::Text("Falling", "%.1f m below the lip", s.fallen);
                ImGuiLTable::End();
            }
        }

        //! Last status message, if any.
        void drawMessage()
        {
            if (!_message.empty())
                ImGui::TextDisabled("%s", _message.c_str());
        }
    };
}
