        //! Controls for a selected drawn waterway.
        void drawUserSelection(const std::string& type)
        {
            bool changed = false;
            if (ImGuiLTable::Begin("rivers_selected"))
            {
                const char* const* types = waterwayTypes();
                int current = 0;
                for (int i = 0; i < numWaterwayTypes(); ++i)
                    if (type == types[i]) current = i;
                if (ImGuiLTable::BeginCombo("Type", types[current]))
                {
                    for (int i = 0; i < numWaterwayTypes(); ++i)
                    {
                        if (ImGui::Selectable(types[i], i == current))
                        {
                            _selected->set("waterway", std::string(types[i]));
                            changed = true;
                        }
                    }
                    ImGuiLTable::EndCombo();
                }
                // no usable width tag: the class default applies
                float width = (float)_selected->getDouble("width", 0.0);
                if (width < 0.3f)
                {
                    const auto& classes = _rivers->getWaterwayClasses();
                    auto c = classes.find(type);
                    width = c != classes.end() ? c->second.width : 8.0f;
                }
                if (ImGuiLTable::SliderFloat("Width (m)", &width, 0.5f, 200.0f, "%.1f", ImGuiSliderFlags_Logarithmic))
                    _selected->set("width", (double)width);
                changed |= ImGui::IsItemDeactivatedAfterEdit();
                ImGuiLTable::End();
            }
            ImGui::TextDisabled("Drag the handles to reshape it (green marks the source).");
            if (ImGui::Button("Reverse flow"))
            {
                GeometryIterator iter(_selected->getGeometry(), false);
                while (iter.hasMore())
                {
                    Geometry* part = iter.next();
                    std::reverse(part->begin(), part->end());
                }
                changed = true;
            }
            ImGui::SameLine();
            if (ImGui::Button("Delete"))
            {
                FeatureID fid = _selected->getFID();
                _dragPending = false;
                clearSelection();
                _rivers->removeWaterway(fid);
                return;
            }
            if (changed)
            {
                _rivers->updateWaterway(_selected.get());
                showSelection(true);
            }
        }

        //! Controls for a selected source waterway (hide it or override its width).
        void drawSourceSelection()
        {
            FeatureID fid = _selected->getFID();
            bool hidden = _rivers->isSourceWaterwayHidden(fid);
            if (ImGui::Button(hidden ? "Show it again" : "Hide it"))
            {
                _rivers->setSourceWaterwayHidden(fid, !hidden);
                _rivers->invalidate(_selected->getExtent());
            }

            float current = _rivers->getSourceWaterwayWidth(fid);
            if (_sourceWidth <= 0.0f)
                _sourceWidth = current > 0.0f ? current : (float)_selected->getDouble("width", 10.0);
            ImGui::SetNextItemWidth(180.0f);
            ImGui::SliderFloat("Width##src", &_sourceWidth, 0.5f, 300.0f, "%.1f m", ImGuiSliderFlags_Logarithmic);
            if (ImGui::IsItemDeactivatedAfterEdit())
            {
                _rivers->setSourceWaterwayWidth(fid, _sourceWidth);
                _rivers->invalidate(_selected->getExtent());
            }
            if (current > 0.0f)
            {
                ImGui::SameLine();
                if (ImGui::Button("Clear override"))
                {
                    _rivers->setSourceWaterwayWidth(fid, 0.0f);
                    _rivers->invalidate(_selected->getExtent());
                    _sourceWidth = 0.0f;
                }
            }
        }

