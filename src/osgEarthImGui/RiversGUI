        //! Named water types that set the optical parameters together.
        static void applyPreset(int preset, RiverLayer::Shading& s)
        {
            switch (preset)
            {
            case 0: // clear mountain stream
                s.turbidity = 0.08f, s.clarity = 1.6f;
                s.deepColor = Color(0.10f, 0.27f, 0.29f, 1.0f), s.sedimentColor = Color(0.36f, 0.34f, 0.27f, 1.0f);
                break;
            case 1: // glacial meltwater: milky turquoise rock flour
                s.turbidity = 0.55f, s.clarity = 0.55f;
                s.deepColor = Color(0.18f, 0.40f, 0.42f, 1.0f), s.sedimentColor = Color(0.47f, 0.60f, 0.60f, 1.0f);
                break;
            case 2: // lowland river: green-brown
                s.turbidity = 0.45f, s.clarity = 0.7f;
                s.deepColor = Color(0.12f, 0.22f, 0.18f, 1.0f), s.sedimentColor = Color(0.35f, 0.34f, 0.24f, 1.0f);
                break;
            case 3: // muddy flood
                s.turbidity = 0.95f, s.clarity = 0.4f;
                s.deepColor = Color(0.20f, 0.17f, 0.12f, 1.0f), s.sedimentColor = Color(0.48f, 0.38f, 0.26f, 1.0f);
                break;
            case 4: // blackwater: tea-colored tannins
                s.turbidity = 0.3f, s.clarity = 0.45f;
                s.deepColor = Color(0.17f, 0.10f, 0.05f, 1.0f), s.sedimentColor = Color(0.30f, 0.20f, 0.10f, 1.0f);
                break;
            case 5: // tropical: clear blue-green
                s.turbidity = 0.04f, s.clarity = 2.2f;
                s.deepColor = Color(0.05f, 0.30f, 0.34f, 1.0f), s.sedimentColor = Color(0.42f, 0.42f, 0.34f, 1.0f);
                break;
            default:
                break;
            }
        }

