        {
            float c[3] = { color.r(), color.g(), color.b() };
            if (!ImGuiLTable::ColorEdit3(label, c, ImGuiColorEditFlags_NoLabel))
                return false;
            color = Color(c[0], c[1], c[2], 1.0f);
            return true;
        }

