<!--
osgEarth Sample - Flowing rivers

Animated rivers, streams and lakes built from the worldwide OpenStreetMap data set.
Waterway centerlines are drawn in the direction of flow, so the water follows them;
mapped river areas get the same current, and polygons without a waterway become
still lakes and ponds.

  River           renders the water and owns the river hydrology.
  RiverCarve      cuts channels and lake beds into the terrain under the water.
  RiverConstraint adds terrain mesh vertices along the banks so the channels hold
                  their shape at every terrain level of detail.

Waterfalls (mapped waterway=waterfall nodes and steep drops under a channel) fall
with streaming whitewater, plunge-pool foam, spray and mist, and rainbows in the
mist when the sun is behind you. Set <waterfalls>false</waterfalls> on the River
layer to leave them out.

The water is lit by whatever sky is active. Try:
  osgearth_imgui rivers.earth --sky
and open Tools > Rivers to tune the water, inspect the flow, and draw or edit rivers.

Imagery is ESRI World Imagery (see tests/arcgisonline.earth); use of ESRI's online
maps may be subject to their terms, and abiding by them is your responsibility.
-->
<map name="Flowing rivers">

    <ArcGISServerImage name="World Imagery">
        <url>https://services.arcgisonline.com/arcgis/rest/services/World_Imagery/MapServer/</url>
        <nodata_image>https://services.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/100/0/0.jpeg</nodata_image>
    </ArcGISServerImage>

    <!-- <XYZElevation name="Mapterhorn elevation">
        <url>https://tiles.mapterhorn.com/{z}/{x}/{y}.webp</url>
        <elevation_encoding>terrarium</elevation_encoding>
        <max_level>17</max_level>
        <stitch_edges>true</stitch_edges>
        <tile_size>512</tile_size>
        <vdatum>egm96</vdatum>
        <attribution>Mapterhorn</attribution>
    </XYZElevation>
     -->
    <xi:include href="readymap_elevation.xml"/>

    <XYZFeatures name="data:osm">
        <url>https://readymap.org/readymap/mbtiles/osm/{z}/{x}/{-y}.pbf</url>
        <min_level>14</min_level>
        <max_level>14</max_level>
        <profile>spherical-mercator</profile>
        <format>pbf</format>
        <fid_attribute>@id</fid_attribute>
        <attribution>&#169;OpenStreetMap contributors</attribution>
    </XYZFeatures>

    <river name="Rivers">
        <features>data:osm</features>
        <max_range>9000</max_range>
    </river>

    <rivercarve name="River channels">
        <river_layer>Rivers</river_layer>
    </rivercarve>

    <riverconstraint name="River banks">
        <river_layer>Rivers</river_layer>
    </riverconstraint>

    <options>
        <terrain lod_method="screen_space" tile_size="33"/>
    </options>

    <viewpoints>
        <viewpoint name="Roaring Fork, Aspen">
            <heading>185</heading>
            <pitch>-14</pitch>
            <range>120m</range>
            <long>-106.811389</long>
            <lat>39.182527</lat>
            <height>2415</height>
        </viewpoint>
        <viewpoint name="Roaring Fork valley overview">
            <heading>200</heading>
            <pitch>-35</pitch>
            <range>2500m</range>
            <long>-106.811389</long>
            <lat>39.182527</lat>
            <height>2415</height>
        </viewpoint>
